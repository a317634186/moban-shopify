{%- comment -%}
  Category entry points. Anchor text uses the collection's real name instead of a
  repeated "View products", so each internal link tells Google what it points at.
{%- endcomment -%}

<section class="section" id="categories" aria-labelledby="CategoriesHeading">
  <div class="section-head">
    <h2 id="CategoriesHeading">{{ section.settings.heading | default: 'Shop adult toys by category' }}</h2>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  <div class="category-grid">
    {%- for block in section.blocks -%}
      {%- comment -%}
        A "collection" setting returns a collection object on current Shopify
        versions and a handle string on older ones. Resolve both.
      {%- endcomment -%}
      {%- assign c = block.settings.collection -%}
      {%- if c != blank and c.handle == blank -%}{%- assign c = collections[c] -%}{%- endif -%}
      {%- assign url = c.url | default: block.settings.fallback_url | default: routes.all_products_collection_url -%}
      {%- assign title = block.settings.heading | default: c.title | default: 'Shop all' -%}
      <a class="category" href="{{ url }}" {{ block.shopify_attributes }}>
        {%- if c.featured_image -%}
          <img class="category-bg" src="{{ c.featured_image | image_url: width: 600 }}"
               srcset="{{ c.featured_image | image_url: width: 400 }} 400w, {{ c.featured_image | image_url: width: 800 }} 800w"
               sizes="(max-width: 900px) 100vw, 400px"
               width="{{ c.featured_image.width }}" height="{{ c.featured_image.height }}"
               alt="{{ title | escape }}" loading="lazy" decoding="async">
        {%- endif -%}
        <div class="category-body">
          <h3>{{ title }}</h3>
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          <span class="btn">Shop {{ title | downcase }}</span>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Categories",
  "settings": [
    { "type": "text", "id": "heading", "label": "H2 heading", "default": "Shop adult toys by category" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Start with what feels right for you." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "heading", "label": "Override title" },
        { "type": "text", "id": "text", "label": "Short description" },
        { "type": "url", "id": "fallback_url", "label": "Fallback link", "info": "Used only if no collection is selected." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories",
      "blocks": [
        { "type": "category", "settings": { "heading": "Vibrators", "text": "Bullet, rabbit, wand and G-spot vibrators." } },
        { "type": "category", "settings": { "heading": "Couples toys", "text": "Remote and app-controlled play for two." } },
        { "type": "category", "settings": { "heading": "Lubricants", "text": "Water-based and silicone, body-safe." } }
      ]
    }
  ]
}
{% endschema %}
