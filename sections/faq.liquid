{%- comment -%}
  FAQ with FAQPage structured data.
  The JSON-LD is generated from the same blocks that render on screen, because
  Google only honours FAQ markup whose answers are visible to the user.
{%- endcomment -%}

<section class="section faq" aria-labelledby="FaqHeading">
  <div class="section-head">
    <h2 id="FaqHeading">{{ section.settings.heading | default: 'Adult toy buying questions, answered' }}</h2>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  <div class="faq-list">
    {%- for block in section.blocks -%}
      <details {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
        <summary><h3>{{ block.settings.question }}</h3></summary>
        <div class="faq-answer">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": {{ canonical_url | append: '#faq' | json }},
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | strip_html | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ block.settings.answer | strip_html | json }}
      }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "H2 heading", "default": "Adult toy buying questions, answered" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Straight answers on materials, discretion and delivery." }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "qa",
          "settings": {
            "question": "Do you ship adult toys in discreet packaging?",
            "answer": "<p>Yes. Every order ships in a plain outer box or bag with no branding, no product images and no mention of adult toys on the label. Your bank statement shows a neutral trading name, so billing is discreet too.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Which sex toy materials are body-safe?",
            "answer": "<p>Look for non-porous materials: medical-grade silicone, ABS plastic, borosilicate glass and stainless steel. These can be cleaned properly and do not absorb bacteria. Avoid jelly, PVC and anything containing phthalates. Every toy we list states its material on the product page.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "What is a good first vibrator for a beginner?",
            "answer": "<p>Most beginners get on best with a small bullet vibrator or a broad, rumbly wand massager. Both are external, easy to control and useful solo or with a partner. Start on the lowest setting and use a water-based lubricant.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Which lubricant should I use with a silicone toy?",
            "answer": "<p>Use a water-based lubricant. Silicone lubricant can degrade the surface of silicone toys over time. Water-based lube is also condom-safe and rinses off easily.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "How do I clean and store adult toys?",
            "answer": "<p>Wash non-porous toys with warm water and a mild unscented soap or a dedicated toy cleaner after every use, then air dry fully. Store toys separately in a pouch so different silicones do not react with each other, and remove batteries from anything you are storing long term.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "question": "Can I return an adult toy?",
            "answer": "<p>For hygiene reasons, intimate products can only be returned unused and in sealed original packaging. Faulty items are covered by the manufacturer warranty — contact us and we will arrange a replacement.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
