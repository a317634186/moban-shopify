<section class="section" id="products" aria-labelledby="FeaturedHeading">
  <div class="section-head">
    <h2 id="FeaturedHeading">{{ section.settings.heading | default: 'Best selling adult toys' }}</h2>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  {%- comment -%} Resolve the collection setting whether it yields an object or a handle. {%- endcomment -%}
  {%- assign source = section.settings.collection -%}
  {%- if source != blank and source.handle == blank -%}{%- assign source = collections[source] -%}{%- endif -%}
  {%- if source == blank or source.products.size == 0 -%}
    {%- assign source = collections.all -%}
  {%- endif -%}

  {%- if source.products.size > 0 -%}
    <div class="products">
      {%- for product in source.products limit: section.settings.count -%}
        {%- render 'product-card', card_product: product, lazy: true -%}
      {%- endfor -%}
    </div>
    <div class="section-cta">
      <a class="btn" href="{{ source.url | default: routes.all_products_collection_url }}">
        Shop all {{ source.title | default: 'adult toys' | downcase }}
      </a>
    </div>
  {%- else -%}
    <p class="empty-note">
      Add products to your store and they will appear here.
      <a href="{{ routes.all_products_collection_url }}">Browse the catalogue</a>.
    </p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "H2 heading", "default": "Best selling adult toys" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Body-safe favourites, discreetly packaged." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
