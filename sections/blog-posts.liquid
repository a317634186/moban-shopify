{%- comment -%} Resolve the blog setting whether it yields an object or a handle. {%- endcomment -%}
{%- assign target = section.settings.blog -%}
{%- if target != blank and target.handle == blank -%}{%- assign target = blogs[target] -%}{%- endif -%}
{%- if target == blank or target.articles.size == 0 -%}{%- assign target = blogs.news -%}{%- endif -%}

<section class="section" id="journal" aria-labelledby="JournalHeading">
  <div class="section-head">
    <h2 id="JournalHeading">{{ section.settings.heading | default: 'Adult toy guides and intimacy advice' }}</h2>
    {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  {%- if target.articles.size > 0 -%}
    <div class="articles">
      {%- for article in target.articles limit: section.settings.count -%}
        <article class="article">
          {%- if article.image -%}
            <a href="{{ article.url }}" class="article-media">
              <img src="{{ article.image | image_url: width: 600 }}"
                   srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 800 }} 800w"
                   sizes="(max-width: 900px) 100vw, 380px"
                   width="{{ article.image.width }}" height="{{ article.image.height }}"
                   alt="{{ article.title | escape }}" loading="lazy" decoding="async">
            </a>
          {%- endif -%}
          <h3><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%-d %B %Y' }}</time>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
          <a href="{{ article.url }}">Read: {{ article.title }}</a>
        </article>
      {%- endfor -%}
    </div>
    <div class="section-cta"><a class="btn" href="{{ target.url }}">All {{ target.title | downcase }} articles</a></div>
  {%- else -%}
    <p class="empty-note">Publish articles to this blog and they will appear here.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "heading", "label": "H2 heading", "default": "Adult toy guides and intimacy advice" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Practical, inclusive advice — no jargon." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "count", "label": "Articles to show", "min": 3, "max": 6, "step": 3, "default": 3 }
  ],
  "presets": [{ "name": "Blog posts" }]
}
{% endschema %}
