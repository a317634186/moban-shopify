{%- comment -%}
  Hero. Carries the single H1 on the homepage.
  LCP notes: the hero image is eager + fetchpriority="high", never lazy, and has
  explicit width/height so it reserves layout space (CLS 0). A <picture> serves a
  smaller crop to phones instead of scaling the desktop file down.
{%- endcomment -%}

<section class="hero" aria-labelledby="HeroHeading">
  <picture>
    {%- comment -%}
      width/height on <source> matter as much as on <img>: without them the
      browser applies the <img> aspect ratio to a differently-shaped mobile crop
      and the layout shifts once the real file arrives.
    {%- endcomment -%}
    {%- if section.settings.image_mobile -%}
      <source media="(max-width: 560px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 560 }} 560w, {{ section.settings.image_mobile | image_url: width: 1120 }} 1120w"
              sizes="100vw"
              width="{{ section.settings.image_mobile.width }}"
              height="{{ section.settings.image_mobile.height }}">
    {%- else -%}
      <source media="(max-width: 560px)" srcset="{{ 'hero-mobile.png' | asset_url }}" width="548" height="800">
    {%- endif -%}

    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}"
           srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
           sizes="(max-width: 1240px) 100vw, 1240px"
           width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
           alt="{{ section.settings.image_alt | default: 'Adult toys and intimate wellness products from Velvet Secret' | escape }}"
           fetchpriority="high" loading="eager" decoding="async">
    {%- else -%}
      <img src="{{ 'hero-desktop.png' | asset_url }}" width="1000" height="444"
           alt="{{ section.settings.image_alt | default: 'Adult toys and intimate wellness products from Velvet Secret' | escape }}"
           fetchpriority="high" loading="eager" decoding="async">
    {%- endif -%}
  </picture>

  <div class="hero-copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 id="HeroHeading">{{ section.settings.heading | default: 'Adult Toys & Intimate Wellness' }}</h1>
    <p>{{ section.settings.subheading | default: 'Body-safe vibrators, couples toys and lubricants — shipped in plain discreet packaging.' }}</p>
    {%- if section.settings.button_label != blank -%}
      <a class="btn light" href="{{ section.settings.button_url | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text",
      "info": "Describe the image for search engines and screen readers. Do not list keywords.",
      "default": "Adult toys and intimate wellness products from Velvet Secret" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NEW IN" },
    { "type": "text", "id": "heading", "label": "H1 heading",
      "info": "The single H1 for the homepage. Lead with the primary keyword, keep it under ~60 characters.",
      "default": "Adult Toys & Intimate Wellness" },
    { "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Body-safe vibrators, couples toys and lubricants — shipped in plain discreet packaging." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all adult toys" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
