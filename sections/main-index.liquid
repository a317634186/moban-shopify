      {% if settings.logo %}<img src="{{ settings.logo | image_url: width: 220 }}" alt="{{ shop.name }}">{% else %}<img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}">{% endif %}
      <span class="brand-name">Velvet Secret</span>
    </a>
    <nav class="nav" aria-label="Main navigation">
      <a class="active" href="{{ routes.root_url }}">Home</a><a href="{{ routes.all_products_collection_url }}">All Products</a><a href="/collections/for-women">For Women</a><a href="/collections/for-men">For Men</a><a href="/collections/couples">Couples</a><a href="/collections/new-in">New In</a><a href="/collections/sale">Sale</a>
