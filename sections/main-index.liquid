<style>
  :root { --ink: {{ settings.ink_color | default: '#1c1b1b' }}; --accent: {{ settings.accent_color | default: '#f94c43' }}; }
</style>
<div class="announcement">{{ settings.announcement }}</div>
<header class="header">
