{% layout 'password' %}

{%- comment -%}
  Storefront password page. Included because development stores are password
  protected by default — without this template the very first theme preview has
  nowhere to render. Explicitly noindex/nofollow via layout/password.liquid.
{%- endcomment -%}

<div class="section notfound">
  <h1>{{ shop.name }}</h1>
  <p>We're opening soon. Enter the store password to take a look around.</p>

  {%- form 'storefront_password', class: 'search-form' -%}
    <label class="visually-hidden" for="StorePassword">Store password</label>
    <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="Store password">
    <button class="btn" type="submit">Enter</button>
    {%- if form.errors -%}
      <p class="form-error" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}
  {%- endform -%}

  <p class="age-note">You must be 18 or over to shop with us.</p>
</div>
