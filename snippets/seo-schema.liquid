{%- comment -%}
  seo-schema.liquid

  JSON-LD structured data. Organization + WebSite on every page, plus
  BreadcrumbList, Product, ItemList or BlogPosting depending on the template.
  FAQPage is emitted by sections/faq.liquid so the markup always matches
  content that is visible on the page (a Google requirement).

  DO NOT move the org_id / site_id assigns below into a multi-line liquid tag
  block. Inside one, a hash character begins a line comment. A hash inside a
  quoted string can be read as the start of that comment, truncating the line
  mid-string. An unterminated string is a parse error, Shopify then refuses to
  save the file, and every page reports
  "Could not find asset snippets/seo-schema.liquid".
  In an ordinary one-line assign tag the hash has no special meaning.
{%- endcomment -%}

{%- assign tname = template.name | default: 'index' -%}
{%- assign org_id = shop.url | append: '/#organization' -%}
{%- assign site_id = shop.url | append: '/#website' -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ org_id | json }},
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ 'logo.png' | asset_url | prepend: 'https:' | json }}
      },
      "description": {{ settings.seo_home_description | default: 'Adult toys, sex toys and intimate wellness products with body-safe materials and discreet packaging.' | json }}
      {%- if settings.social_links != blank -%}
      ,"sameAs": [
        {%- assign social = settings.social_links | split: ',' -%}
        {%- for link in social -%}
          {{ link | strip | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
      {%- endif -%}
    },
    {
      "@type": "WebSite",
      "@id": {{ site_id | json }},
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }},
      "inLanguage": {{ request.locale.iso_code | json }},
      {%- comment -%}
        Declares the site as adult, matching the rating/RTA meta tags. Honest
        classification keeps the store out of family-filtered surfaces instead
        of being demoted for misrepresenting itself.
      {%- endcomment -%}
      "isFamilyFriendly": false,
      "publisher": { "@id": {{ org_id | json }} },
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }}
        },
        "query-input": "required name=search_term_string"
      }
    }

    {%- comment -%} ---------------------------------------- BREADCRUMBS {%- endcomment -%}
    {%- unless tname == 'index' -%}
    ,{
      "@type": "BreadcrumbList",
      "@id": {{ canonical_url | append: '#breadcrumb' | json }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ shop.url | json }}
        }
        {%- if tname == 'product' -%}
          {%- if collection.title != blank -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} }
          ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
          {%- else -%}
          ,{ "@type": "ListItem", "position": 2, "name": "Adult Toys", "item": {{ shop.url | append: routes.all_products_collection_url | json }} }
          ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
          {%- endif -%}
        {%- elsif tname == 'collection' -%}
          ,{ "@type": "ListItem", "position": 2, "name": "Shop", "item": {{ shop.url | append: routes.collections_url | json }} }
          ,{ "@type": "ListItem", "position": 3, "name": {{ collection.title | json }} }
        {%- elsif tname == 'article' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} }
          ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | json }} }
        {%- elsif tname == 'blog' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }} }
        {%- elsif tname == 'page' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ page.title | json }} }
        {%- else -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ page_title | json }} }
        {%- endif -%}
      ]
    }
    {%- endunless -%}

    {%- comment -%} ------------------------------------------- PRODUCT {%- endcomment -%}
    {%- if tname == 'product' -%}
    {%- assign variant = product.selected_or_first_available_variant -%}
    ,{
      "@type": "Product",
      "@id": {{ shop.url | append: product.url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ shop.url | append: product.url | json }},
      "description": {{ product.description | strip_html | truncatewords: 60 | json }},
      "category": {{ product.type | default: 'Adult Toys' | json }},
      "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
      {%- if variant.sku != blank %}"sku": {{ variant.sku | json }},{% endif %}
      {%- if variant.barcode != blank %}"gtin": {{ variant.barcode | json }},{% endif %}
      "image": [
        {%- for image in product.images limit: 6 -%}
          {{ image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "isFamilyFriendly": false,
      {%- comment -%}
        Review stars. Emitted ONLY when a review app has written real data to the
        standard metafields, and the same numbers are rendered visibly by
        snippets/rating.liquid — Google requires the rating to be on the page,
        and fabricated ratings get rich results revoked domain-wide.
      {%- endcomment -%}
      {%- assign review_count = product.metafields.reviews.rating_count.value -%}
      {%- assign review_rating = product.metafields.reviews.rating.value -%}
      {%- if review_count > 0 and review_rating.rating != blank -%}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ review_rating.rating | json }},
        "ratingCount": {{ review_count | json }},
        "bestRating": {{ review_rating.scale_max | default: 5 | json }},
        "worstRating": {{ review_rating.scale_min | default: 1 | json }}
      },
      {%- endif -%}
      {%- if product.variants.size > 1 -%}
      "offers": {
        "@type": "AggregateOffer",
        "url": {{ shop.url | append: product.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "lowPrice": {{ product.price_min | divided_by: 100.0 }},
        "highPrice": {{ product.price_max | divided_by: 100.0 }},
        "offerCount": {{ product.variants.size }},
        "priceValidUntil": "{{ 'now' | date: '%Y' | plus: 1 }}-01-01",
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
      }
      {%- else -%}
      "offers": {
        "@type": "Offer",
        "url": {{ shop.url | append: product.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ variant.price | divided_by: 100.0 }},
        "priceValidUntil": "{{ 'now' | date: '%Y' | plus: 1 }}-01-01",
        "itemCondition": "https://schema.org/NewCondition",
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "seller": { "@id": {{ org_id | json }} }
      }
      {%- endif -%}
    }
    {%- endif -%}

    {%- comment -%} ---------------------------- COLLECTION AS ITEMLIST {%- endcomment -%}
    {%- if tname == 'collection' and collection.products.size > 0 -%}
    ,{
      "@type": "ItemList",
      "@id": {{ canonical_url | append: '#itemlist' | json }},
      "name": {{ collection.title | json }},
      "numberOfItems": {{ collection.products_count }},
      "itemListElement": [
        {%- for product in collection.products limit: 24 -%}
        {
          "@type": "ListItem",
          "position": {{ forloop.index }},
          "url": {{ shop.url | append: product.url | json }},
          "name": {{ product.title | json }}
        }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
    {%- endif -%}

    {%- comment -%} --------------------------------------- BLOGPOSTING {%- endcomment -%}
    {%- if tname == 'article' -%}
    ,{
      "@type": "BlogPosting",
      "@id": {{ shop.url | append: article.url | append: '#article' | json }},
      "headline": {{ article.title | json }},
      "url": {{ shop.url | append: article.url | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "description": {{ article.excerpt_or_content | strip_html | truncatewords: 40 | json }},
      {%- if article.image %}"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
      "author": { "@type": "Organization", "name": {{ article.author | default: shop.name | json }} },
      "publisher": { "@id": {{ org_id | json }} },
      "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} }
    }
    {%- endif -%}
  ]
}
</script>
