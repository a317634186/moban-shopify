<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% assign seo_title = page_title | default: 'Velvet Secret | Adult Toys & Intimate Wellness' %}
    {% assign seo_description = page_description | default: settings.seo_description | default: 'Shop adult toys, sex toys and intimate wellness at Velvet Secret. Discover vibrators, massage wands, couples toys, lubricants and discreet delivery.' %}
    {% assign seo_keywords = settings.seo_keywords | default: 'adult toys, sex toys, intimate wellness, vibrators, massage wands, couples toys, lubricants, discreet shipping, 成人用品, 情趣用品, 成人玩具, 情趣玩具, 情侣用品' %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.ink_color | default: '#1c1b1b' }}">
    <meta name="description" content="{{ seo_description | strip_html | escape }}">
    <meta name="keywords" content="{{ seo_keywords | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ seo_title | escape }}{% unless seo_title contains 'Velvet Secret' %} | Velvet Secret{% endunless %}</title>
    <meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
    <meta property="og:title" content="{{ seo_title | escape }}">
    <meta property="og:description" content="{{ seo_description | strip_html | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:site_name" content="Velvet Secret">
    {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% else %}<meta property="og:image" content="https:{{ 'hero-desktop.png' | asset_url }}">{% endif %}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ seo_title | escape }}">
    <meta name="twitter:description" content="{{ seo_description | strip_html | escape }}">
    <script type="application/ld+json">
      {
        "@context":"https://schema.org",
        "@graph":[
          {"@type":"Organization","@id":"{{ shop.url }}/#organization","name":"Velvet Secret","url":"{{ shop.url }}","logo":"https:{{ 'logo.png' | asset_url }}"},
          {"@type":"WebSite","@id":"{{ shop.url }}/#website","url":"{{ shop.url }}","name":"Velvet Secret","publisher":{"@id":"{{ shop.url }}/#organization"},"potentialAction":{"@type":"SearchAction","target":"{{ shop.url }}{{ routes.search_url }}?q={search_term_string}","query-input":"required name=search_term_string"}}
        ]
      }
    </script>
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    {{ content_for_layout }}
    {{ 'theme.js' | asset_url | script_tag }}
  </body>
</html>
